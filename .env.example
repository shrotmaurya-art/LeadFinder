CITIES=Virar,Vasai,Nalasopara,Bhayander,Mira Road,Borivali,Malad,Andheri,Mumbai  # Comma-separated cities to scout
CATEGORIES                       # Comma-separated list of business categories
OLLAMA_MODEL=llama3.1:8b         # Ollama model name
COOLDOWN_DAYS=15                 # Days to wait before re-contacting a lead
MAX_FOLLOW_UPS=2                 # Max follow-up messages per lead
EMAIL_DAILY_CAP=30               # Max emails to send per day
EMAIL_LINK_STYLE=mailto          # "mailto" (OS default mail app) or "gmail_web" (Gmail web compose)
WHATSAPP_DAILY_CAP=30            # Max WhatsApp messages per day
LEAD_SCORE_THRESHOLD=40          # Minimum score to qualify a lead
APP_TIMEZONE=Asia/Kolkata        # Application timezone
DATA_SOURCE=playwright           # Data source: playwright or api
GOOGLE_PLACES_API_KEY=           # Google Places API key (optional)
INCLUDE_RATINGS_VIA_API=false    # Fetch ratings via API instead of scraping
NOTIFY_EMAIL=                    # Email address for operator notifications
SMTP_HOST=smtp.gmail.com         # SMTP server host
SMTP_PORT=587                    # SMTP server port
SMTP_USER=                       # SMTP username (usually your email)
SMTP_PASSWORD=                   # SMTP password (use an App Password, see README)
ENABLE_EMAIL_NOTIFY=true         # Send email notifications after daily run
ENABLE_DESKTOP_NOTIFY=true       # Send desktop notifications after daily run

# Freelancer profile (used in outreach messages)
FREELANCER_NAME=                  # Your name for outreach sign-off
FREELANCER_PITCH=independent freelance web developer — modern, fast, affordable websites  # One-line value prop
STARTING_PRICE=Rs. 3,999         # Starting price shown in outreach
PORTFOLIO_URL=kingsgym-7f75d.web.app                    # Optional live-demo / portfolio link

# Scout / Playwright settings
SEARCH_DELAY_MIN=2.0              # Min seconds between search/scroll actions
SEARCH_DELAY_MAX=5.0              # Max seconds between search/scroll actions
PAGE_LOAD_TIMEOUT_MS=10000        # Playwright selector wait timeout (ms)
MAX_SCROLL_ATTEMPTS=3             # Max scroll retries when no new cards found
SCROLL_TARGET_RESULTS=20          # Target number of listings per search

# Google Places API settings
PLACES_CACHE_TTL_SECONDS=86400    # Cache TTL for Places API responses (seconds)
PLACES_API_TIMEOUT=30             # HTTP timeout for Places API requests (seconds)

# Website extraction settings
CONTENT_FETCH_TIMEOUT=8           # HTTP timeout when scraping business websites (seconds)

# Deduplication settings
SOFT_MATCH_THRESHOLD=90           # Fuzzy name+address match threshold (0-100)

# Outreach sender settings
COPY_FALLBACK_LIMIT=1800          # URL length before switching to copy-paste fallback

# Ollama settings
OLLAMA_URL=http://localhost:11434  # Ollama server URL
OLLAMA_TIMEOUT=15                 # HTTP timeout for Ollama requests (seconds)
OLLAMA_RETRIES=2                  # Retry count before OllamaUnavailableError
OLLAMA_STARTUP_TIMEOUT=20         # Max seconds to wait for Ollama to start

# LLM generation token limits
EMAIL_MAX_TOKENS=250              # Max tokens for email body generation
SUBJECT_MAX_TOKENS=30             # Max tokens for email subject generation
WHATSAPP_MAX_TOKENS=120           # Max tokens for WhatsApp message generation
WHATSAPP_CHAR_LIMIT=400           # Max WhatsApp message characters

# Database settings
SQLITE_BUSY_TIMEOUT_MS=5000       # SQLite WAL busy timeout (ms)

# Analyzer / scoring settings
REVIEW_COUNT_BAND=20              # Review count threshold for recommendation priority
RATING_THRESHOLD=4.0              # Min Google rating for score bonus

# Dashboard settings
STREAMLIT_URL=http://localhost:8501  # Streamlit URL shown in notifications
ENABLE_DASHBOARD_AUTO_SCOUT=true    # Set false when dashboard runs in container without Playwright/Ollama
